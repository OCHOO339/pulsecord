{
  "appId": "org.pulsecord.installer", "productName": "PulseCord Installer",
  "compression": "store",
  "artifactName": "PulseCord Installer.${ext}",
  "directories": { "output": "release" },
  "files": ["packages/installer/**", "package.json", "LICENSE", "NOTICE.md"],
  "extraMetadata": { "main": "packages/installer/main.cjs" },
  "extraResources": [{ "from": "dist/bundle", "to": "bundle" }],
  "win": { "target": "portable", "icon": "build/icon.ico", "signAndEditExecutable": true },
  "linux": { "target": ["AppImage", "tar.gz"], "artifactName": "PulseCord Installer-linux-${arch}.${ext}", "category": "Utility", "icon": "build/icon.png", "executableName": "pulsecord-installer" },
  "mac": { "target": "dmg", "identity": null }
}
